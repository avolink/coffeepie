# Proxmox connection
PROXMOX_URL=https://your-proxmox-host:8006/api2/json
# Do NOT use root@pam. Create a dedicated API user whose role has only what
# this service does (VM.Allocate, VM.Clone, VM.PowerMgmt, VM.Audit, VM.Console,
# Datastore.AllocateSpace on the relevant paths), e.g. coffeepie-api@pve.
PROXMOX_USER=coffeepie-api@pve
PROXMOX_PASSWORD=generate-a-long-random-password

# Firebase (from Firebase Console -> Project Settings -> General -> Web app)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdef
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Admin SDK (path to service account JSON)
FIREBASE_ADMIN_SDK_JSON=app/secrets/firebase-adminsdk.json

# Sunshine. Credentials must be unique and random per deployment (ideally per
# VM); never reuse an example value. The service refuses to call Sunshine with
# these unset.
SUNSHINE_USERNAME=
SUNSHINE_PASSWORD=
# REQUIRED: networks the service may contact when sending a Sunshine PIN
# (comma-separated CIDRs, the VM subnet). With this unset, /sunshine/send-pin
# rejects every request.
SUNSHINE_ALLOWED_NETWORKS=10.0.0.0/24
