# Radxa ZERO 3E V1.2 sheet 07 (RK3566_GMAC1/CSI)
SHEET soc_gmac
# --- U1P MIPI CSI RX: camera connector J7 is NOT carried over to the Commander (no camera) ---
NC U1 AP18 AR18 AR17 AP17 AP15 AR15 AR14 AP14 1V9 1U9 1V8 1U8
P U1 1N9=VDDA_0V9 1P9=MIPI_AVDD_1V8
C57 100nF MIPI_AVDD_1V8 GND
C58 100nF VDDA_0V9 GND
# --- U1M VCCIO6 domain (3.3 V): RGMII to the PHY ---
# 1T2 (CAMERAB_PDN_L on the 3E) now resets the USB hubs; 1U1 is TYPEC_INT again (battery-port FUSB302B); AB2 (CIF_CLKOUT) and I2C4_M0 are unused
P U1 1T2=HUB_RESET_SOC_N 1U1=TYPEC_INT
NC U1 AP1 AN2 AM2 AM1 1R2 1T1 AB2 AF2 AE2
P U1 AL2=GMAC1_TXD2_M1 AL1=GMAC1_TXD3_M1 AK2=GMAC1_TXCLK_M1 1P2=PHY1_RXD2_PLLOFF 1R1=PHY1_RXD3_PHYAD0
P U1 AJ2=GMAC1_RXCLK_M1 1N2=GMAC1_TXD0_M1 AJ1=GMAC1_TXD1_M1 AH2=GMAC1_TXEN_M1
P U1 1N1=PHY1_RXD0_RXDLY 1L2=PHY1_RXD1_TXDLY AG2=PHY1_RXDV_PHYAD2
P U1 AF1=I2C2_SDA_M1 AD1=I2C2_SCL_M1
P U1 1L1=GMAC1_MDC_M1 AC2=GMAC1_MDIO_M1 AB1=GMAC1_MCLKINOUT_M1
P U1 1L4=VCC_3V3 1L5=VCC_3V3
C61 100nF VCC_3V3 GND
R35 2.2K VCC_3V3 I2C2_SDA_M1
R36 2.2K VCC_3V3 I2C2_SCL_M1
