# Transcribed from Radxa ZERO 3E V1.2 schematic, sheet 04 (RK3566_SARADC/GPIO)
SHEET soc_misc
# --- U1K VCCIO4 domain: WiFi/BT SDIO bank, unused on the 3E ---
NC U1 1C19 1E18 1D18 1A20 B35 B37 A35 B34 1C20 F38 F37 G37 D38 A37 B36 C37 1D19 1B20 D37 B38
P U1 1E16=VCCIO_WL
R10 0R VCCIO_WL VCC_1V8
C53 100nF VCCIO_WL GND
# --- U1N VCCIO7 domain ---
# GPIO4_C2/C3/C5 fed the 40-pin header on the 3E: now the battery-port controls (33_battery_port.net)
P U1 1U7=BATT_VBUS_EN AP12=PWR_SRC_ST 1U6=BATT_VBUS_FLT_N
NC U1 1T6
P U1 AR12=HDMITX_SCL AP11=HDMITX_SDA 1V5=GPIO4_D1_3V3 1N8=VCC_3V3
NC U1 1V6
C54 100nF VCC_3V3 GND
# --- U1O SARADC / OTP ---
P U1 1D17=SARADC_VIN0_KEY_RECOVERY 1C17=SARADC_VIN1 1B18=SARADC_VIN2 1D16=VCCA_1V8 1D15=VCCA_1V8
NC U1 1A19
TP1 TP SARADC_VIN0_KEY_RECOVERY
R25 10K_1% VCCA_1V8 SARADC_VIN0_KEY_RECOVERY
C55 1nF SARADC_VIN0_KEY_RECOVERY GND
C56 100nF VCCA_1V8 GND
# HW_ID / BOM_ID dividers
R27 51K_1% VCCA_1V8 SARADC_VIN1
R29 36K_1% SARADC_VIN1 GND
R28 10K_1% VCCA_1V8 BOM_ID_DIV
R90728 0R SARADC_VIN2 BOM_ID_DIV
R30 DNP BOM_ID_DIV GND
