# Radxa ZERO 3E V1.2 sheets 09 (RK3566_GPIO, VCCIO5) and 10 (RK3566_Audio/SDMMC0)
SHEET soc_gpio
# --- U1L VCCIO5 domain (3.3 V). On the 3E these feed the 40-pin header, which the Commander drops.
#     Only I2C3_M1 and the two Ethernet control lines are still used. ---
NC U1 1U5 AR10 AP10 AR9
NC U1 AP9 1U4 1V3 AR7 AP7 AR6 AP6 1U3 AP4 AP3 AR2 1P3 1P4
P U1 1T4=I2C3_SCL_M1 1V2=I2C3_SDA_M1 AP5=GMAC1_INT_PMEB AR4=GMAC1_RSTN
P U1 1N5=VCC_3V3 1N6=VCC_3V3
C75 100nF VCC_3V3 GND
R52 2.2K VCC_3V3 I2C3_SCL_M1
R53 2.2K VCC_3V3 I2C3_SDA_M1
# --- U1H VCCIO1 domain (audio codec IO, 3.3 V via VCCIO_ACODEC) ---
NC U1 A22 B22 1A13
P U1 A23=I2S1_MCLK_M0_PMIC B23=I2S1_SCLK_TX_M0_PMIC
P U1 B24=I2S1_LRCK_TX_M0_PMIC 1A14=PDM_CLK0_M0_PMIC B25=I2S1_SDO0_M0_PMIC 1B14=I2S1_SDI0_M0_PMIC
NC U1 1B13 A26 B26
P U1 1D13=VCCIO_ACODEC
C76 100nF VCCIO_ACODEC GND
# --- U1J VCCIO3 domain (microSD) ---
P U1 1E20=SDMMC0_D0 1F19=SDMMC0_D1 1D20=SDMMC0_D2 1F18=SDMMC0_D3 1E19=SDMMC0_CMD G38=SDMMC0_CLK_SOC
P U1 1F17=VCCIO_SD
R18 22R SDMMC0_CLK_SOC SDMMC0_CLK
C221 DNP SDMMC0_CLK GND
C43 100nF VCCIO_SD GND
