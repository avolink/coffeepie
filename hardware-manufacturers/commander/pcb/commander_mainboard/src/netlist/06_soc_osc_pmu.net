# Radxa ZERO 3E V1.2 sheet 06 (RK3566_OSC/PLL/PMUIO)
SHEET soc_pmu
# --- 24 MHz oscillator ---
P U1 AD38=XOUT24M AD37=XIN24M
R3 22R XOUT24M XTAL24_X1
R4 1M XOUT24M XIN24M
Y1 XTAL4:24MHz 1=XTAL24_X1 2=GND 3=XIN24M 4=GND
C28 18pF XTAL24_X1 GND
C29 18pF XIN24M GND
P U1 1M18=DFTJTAG_TRSTN_D
R6 0R GND DFTJTAG_TRSTN_D
NC U1 1N19 1M19 1N20 1P20
# --- PLL supplies ---
P U1 1P17=VDDA0V9_PMU 1N18=VCCA1V8_PMU 1N17=GND 1H5=VDDA_0V9 1H4=VCCA_1V8 1J5=GND
C31 1uF VDDA0V9_PMU GND
C32 100nF VDDA0V9_PMU GND
C33 1uF VCCA1V8_PMU GND
C34 100nF VCCA1V8_PMU GND
C35 1uF VDDA_0V9 GND
C36 100nF VDDA_0V9 GND
C38 1uF VCCA_1V8 GND
C39 100nF VCCA_1V8 GND
# --- PMUIO1 (3.3 V) ---
P U1 AG38=NPOR 1P18=USER_LED2 1R20=TSADC_SHUT_M0 1P19=PMIC_SLEEP_H 1R19=PMIC_INT_L AF37=SDMMC0_DET_L AF38=FLASH_VOL_SEL 1P16=VCC3V3_PMU
NC U1 AG37 AJ38
C27 100nF NPOR GND
R2 0R NPOR RESETN
R5 0R TSADC_SHUT_M0 RESETN
C30 100nF VCC3V3_PMU GND
R104 10K VCC3V3_PMU FLASH_VOL_SEL
R106 DNP FLASH_VOL_SEL GND
# --- PMUIO2 (1.8 V) ---
P U1 1T20=PMIC_32KOUT_SOC AJ37=I2C0_SCL_PMIC AK38=I2C0_SDA_PMIC 1V19=UART2_RX_M0 1U18=UART2_TX_M0
NC U1 1U19 AK37 AM38 1U20 1R16 1R17 1T19 1R18 AM37 AN38 AN37 1T18 1V20
P U1 1N15=VCCA1V8_PMU 1N16=VDDA0V9_PMU
C37 100nF VCCA1V8_PMU GND
C40 100nF VDDA0V9_PMU GND
C41 1uF VDDA0V9_PMU GND
R7 2.2K VCCA1V8_PMU I2C0_SCL_PMIC
R8 2.2K VCCA1V8_PMU I2C0_SDA_PMIC
# --- debug UART2 1.8 V <-> 3.3 V level shifters ---
Q1 NMOS_GSD:2SK3018 G=VCCA1V8_PMU S=UART2_RX_M0 D=UART2_RX_3V3
R11 10K VCCA1V8_PMU UART2_RX_M0
R12 22K VCC3V3_PMU UART2_RX_3V3
R13 100R UART2_RX_3V3 UART2_RX
ED1 ESD:BTR04G02 UART2_RX GND
Q2 NMOS_GSD:2SK3018 G=VCCA1V8_PMU S=UART2_TX_M0 D=UART2_TX_3V3
R14 10K VCCA1V8_PMU UART2_TX_M0
R15 22K VCC3V3_PMU UART2_TX_3V3
R16 100R UART2_TX_3V3 UART2_TX
ED2 ESD:BTR04G02 UART2_TX GND
