# microSD + status LED from Radxa ZERO 3E V1.2 sheet 19; the 40-pin header is NOT carried over.
# NEW for the Commander: eMMC (the 3E leaves the eMMC bank unpopulated), ID EEPROM, service header, buttons.
SHEET storage
# --- microSD (boot / recovery media) ---
J6 MICROSD 1=SDMMC0_D2 2=SDMMC0_D3 3=SDMMC0_CMD 4=VCC3V3_SD 5=SDMMC0_CLK 6=GND 7=SDMMC0_D0 8=SDMMC0_D1 CD=SD_CD SH=GND
R90723 0R VCC3V3_SYS VCC3V3_SD
C227 100nF VCC3V3_SD GND
R137 0R SD_CD SDMMC0_DET_L
D13 ESD:BTR04G02 SD_CD GND
D14 ESD:BTR04G02 SDMMC0_D1 GND
D15 ESD:BTR04G02 SDMMC0_D0 GND
D16 ESD:BTR04G02 SDMMC0_CLK GND
D17 ESD:BTR04G02 SDMMC0_CMD GND
D18 ESD:BTR04G02 SDMMC0_D3 GND
D19 ESD:BTR04G02 SDMMC0_D2 GND
# --- eMMC 5.1, 153-ball (16 GB on the Commander Basic). Standard RK356x hook-up, HS200 at 1.8 V IO.
#     AUDIT: not present on the 3E schematic - check against the Rockchip RK3566 hardware design guide. ---
P U1 A32=EMMC_D0 B27=EMMC_D1 B32=EMMC_D2 B29=EMMC_D3 B33=EMMC_D4 A30=EMMC_D5 B30=EMMC_D6 A33=EMMC_D7
P U1 A27=EMMC_CMD A29=EMMC_CLK_SOC 1A16=EMMC_DS 1B16=EMMC_RSTN
NC U1 1A15 1A17 1A18 1B17 1C15
U20 EMMC153 A3=EMMC_D0 A4=EMMC_D1 A5=EMMC_D2 B2=EMMC_D3 B3=EMMC_D4 B4=EMMC_D5 B5=EMMC_D6 B6=EMMC_D7 M5=EMMC_CMD M6=EMMC_CLK H5=EMMC_DS K5=EMMC_RSTN C2=EMMC_VDDI
N U20 VCC_3V3 E6 F5 J10 K9
N U20 VCCIO_FLASH C6 M4 N4 P3 P5
N U20 GND E7 G5 H10 K8 C4 N2 N5 P4 P6
R401 22R EMMC_CLK_SOC EMMC_CLK
R402 10K VCCIO_FLASH EMMC_CMD
R403 10K VCCIO_FLASH EMMC_RSTN
R404 47K EMMC_DS GND
C401 2.2uF VCC_3V3 GND
C402 100nF VCC_3V3 GND
C403 2.2uF VCCIO_FLASH GND
C404 100nF VCCIO_FLASH GND
C405 1uF EMMC_VDDI GND
TP3 TP EMMC_CLK
# --- status LED ---
R41 5.1K VCC3V3_SYS LED1_A
R42 2.2K USER_LED2 LED1_A
LED1 LED:GREEN A=LED1_A K=GND
# --- identity EEPROM (serial / MAC / OEM record, website requirement 15) on I2C2_M1 ---
U21 AT24C02 1=I2C2_SCL_M1 2=GND 3=I2C2_SDA_M1 4=VCC_3V3 5=EEPROM_WP
R405 10K VCC_3V3 EEPROM_WP
TP4 TP EEPROM_WP
C406 100nF VCC_3V3 GND
# --- service header (3.3 V debug UART) and buttons ---
J21 HDR1x4 1=GND 2=UART2_TX 3=UART2_RX 4=VCC3V3_SYS
SW1 TACT:RECOVERY 1=SARADC_VIN0_KEY_RECOVERY 2=GND
SW2 TACT:RESET 1=RESETN 2=GND
