# Radxa ZERO 3E V1.2 sheet 05 (RK3566_USB/PCIE/EMMC)
SHEET soc_usb
# --- U1U USB2 OTG0 / HOST1 / USB3 combo PHY ---
P U1 R37=USB_OTG0_DP R38=USB_OTG0_DM T38=USB_OTG0_VBUSDET T37=USB_OTG0_ID
P U1 1J19=USB3_HOST1_DP 1J20=USB3_HOST1_DM
P U1 1J17=USB3_AVDD_0V9 1H16=USB3_AVDD_1V8 1H18=USB3_AVDD_3V3
P U1 W37=USB3_HOST1_SSTXP W38=USB3_HOST1_SSTXN V38=USB3_HOST1_SSRXP V37=USB3_HOST1_SSRXN
NC U1 AA37 AA38 AB37 AB38 1K19 1K20
P U1 1K16=VDDA_0V9 1K17=VCCA_1V8
C44 100nF USB_OTG0_VBUSDET GND
R19 1R_1% USB3_AVDD_0V9 VDDA_0V9
R20 1R_1% USB3_AVDD_1V8 VCCA_1V8
R21 0R USB3_AVDD_3V3 VCC_3V3
C45 100nF USB3_AVDD_3V3 GND
C46 100nF USB3_AVDD_1V8 GND
C47 100nF USB3_AVDD_0V9 GND
C51 100nF VDDA_0V9 GND
C52 100nF VCCA_1V8 GND
# --- U1V USB2 HOST2 / HOST3 ---
# Radxa leaves HOST3 (Y2/Y1) unconnected; Commander uses it for the keyboard link (see 30_hub.net)
P U1 V2=USB2_HOST2_DP V1=USB2_HOST2_DM
P U1 1J4=USB3_AVDD_0V9 1J3=USB3_AVDD_1V8 1J2=USB3_AVDD_3V3
C48 DNP USB3_AVDD_3V3 GND
C49 DNP USB3_AVDD_1V8 GND
C50 DNP USB3_AVDD_0V9 GND
# --- U1I VCCIO2 (eMMC/FSPI) domain: unpopulated on the 3E; Commander adds eMMC (see 21_emmc.net) ---
P U1 1C13=VCCIO_FLASH
C42 100nF VCCIO_FLASH GND
R68 DNP VCC_3V3 VCCIO_FLASH
R69 0R VCC_1V8 VCCIO_FLASH
C140 4.7uF VCCIO_FLASH GND
