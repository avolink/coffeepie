# Adapted from Radxa ZERO 3E V1.2 sheet 18 (Power IN).
# CHANGED vs the 3E: the 5 V rail now comes from the on-board PoE converter (VOUT_5V, see 30_poe.net)
# instead of the USB-C power port. J2 stays as an internal SERVICE port: USB2 OTG for factory flashing
# (rockusb / maskrom) and, through D30, a bench supply so the board can be flashed without a PoE switch.
SHEET power
# --- 5 V system rail (VCC5V_BUS = output of the PoE / battery selector U81, see 33_battery_port.net) ---
R107 FB120R_3A VCC5V_BUS VCC_SYS
ED6 TVS:AZ5825-01F VCC_SYS GND
C151 22uF VCC_SYS GND
C150 100nF VCC_SYS GND
C15 2.2nF VCC_SYS VSYS_SNUB
R82 75R VSYS_SNUB GND
# --- service USB-C (UFP, USB 2.0 only). R909, R910 are 6R9, 6R10 on the Radxa schematic ---
J2 USBC16 A4=SVC_VBUS A9=SVC_VBUS B4=SVC_VBUS B9=SVC_VBUS A5=SVC_CC1 B5=SVC_CC2 A7=SVC_DM B7=SVC_DM A6=SVC_DP B6=SVC_DP A1=GND A12=GND B1=GND B12=GND SH=GND
NC J2 A8 B8
R909 5.1K SVC_CC1 GND
R910 5.1K SVC_CC2 GND
C149 100nF SVC_VBUS GND
D3 TVS:SMF5.0CA SVC_VBUS GND
D30 SCHOTTKY:SS34 A=SVC_VBUS K=VOUT_5V
L9 CMC:BCMF122P900H 1=SVC_DM 2=USB_OTG0_DM 3=SVC_DP 4=USB_OTG0_DP
R108 DNP SVC_DM USB_OTG0_DM
R109 DNP SVC_DP USB_OTG0_DP
D5 ESD:BTR04G02 SVC_DM GND
D4 ESD:BTR04G02 SVC_DP GND
# VBUS detect now follows the real service-port VBUS (the 3E hard-wires it to VCC_SYS)
R111 2.2K SVC_VBUS OTG_VBUS_DIV
R33 4.3K OTG_VBUS_DIV GND
R110 22R OTG_VBUS_DIV USB_OTG0_VBUSDET
R112 DNP OTG_VBUS_DIV USB_OTG0_ID
TP2 TP USB_OTG0_ID
# --- VCC_3V3 (switched off in sleep) ---
Q5 PMOS_GSD:WPM3407 G=VCC3V3_GATE S=VCC3V3_SYS D=VCC_3V3
C90 22uF VCC3V3_SYS GND
C91 100nF VCC3V3_SYS VCC3V3_GATE
R65 100K VCC3V3_SYS VCC3V3_GATE
R66 10K VCC3V3_GATE PMIC_SLEEP_H
R67 10K PMIC_SLEEP_H GND
C89 22uF VCC_3V3 GND
C152 100nF VCC_3V3 GND
# --- VDD_CPU: RK860-0 ---
U3 RK860 D1=VCC_SYS D2=VCC_SYS E1=VCC_SYS E2=VCC_SYS A2=RK860_EN A1=PMIC_SLEEP_H B1=I2C0_SDA_PMIC A3=I2C0_SCL_PMIC B4=GND
P U3 D3=RK860_SW D4=RK860_SW E3=RK860_SW E4=RK860_SW A4=VDD_CPU B2=GND B3=GND C1=GND C2=GND C3=GND C4=GND
C77 100nF VCC_SYS GND
C78 22uF VCC_SYS GND
R56 51K VCC3V3_PMU RK860_EN
C82 100nF RK860_EN GND
L2 0.24uH_2520 RK860_SW VDD_CPU
R57 100R VDD_CPU VDD_CPU
C79 100nF VDD_CPU VDD_CPU
C80 22uF VDD_CPU GND
C81 22uF VDD_CPU GND
# --- chassis to signal ground ---
R400 1M CHASSIS GND
C400 4.7nF_2kV CHASSIS GND
