# NEW for the Commander: USB 2.0 hub (Microchip USB2517, 7 ports) on the RK3566 USB2 HOST2 port,
# plus the internal keyboard link on USB2 HOST3 (unused on the Radxa ZERO 3E).
# CFG_SEL[2:0] = 110: internal default configuration, strap options disabled, individual port power.
SHEET usb2_hub
U50 USB2517 59=USB2_HOST2_DP 58=USB2_HOST2_DM 44=VCC3V3_HUB 43=HUB_RESET_N 19=GND 61=HUB2_XI 60=HUB2_XO 63=HUB2_RBIAS
P U50 2=USB_P5_DP 1=USB_P5_DM 4=USB_P6_DP 3=USB_P6_DM 7=USB_P7_DP 6=USB_P7_DM 9=USB_P8_DP 8=USB_P8_DM 12=USB_P9_DP 11=USB_P9_DM
P U50 54=USB_AUX_DP 53=USB_AUX_DM
P U50 29=HUB2_PRTPWR1 26=HUB2_PRTPWR2 23=HUB2_PRTPWR3 20=HUB2_PRTPWR4 30=HUB2_PRTPWR5
P U50 28=HUB2_OCS1_N 27=HUB2_OCS2_N 22=HUB2_OCS3_N 21=HUB2_OCS4_N 35=HUB2_OCS5_N
P U50 13=HUB2_CFG_SEL2 42=HUB2_CFG_SEL1 41=HUB2_CFG_SEL0 40=HUB2_SDA 25=HUB2_VDD18 62=HUB2_VDD18PLL 65=GND
N U50 VCC3V3_HUB 46 5 10 52 57 64 24
# port 7 and the LED / indicator pins are unused
NC U50 56 55 36 37 39 38 45 15 17 31 33 47 49 51 14 16 18 32 34 48 50
Y50 XTAL4:24MHz 1=HUB2_XI 2=GND 3=HUB2_XO 4=GND
C701 18pF HUB2_XI GND
C702 18pF HUB2_XO GND
R701 12K_1% HUB2_RBIAS GND
R702 10K VCC3V3_HUB HUB2_CFG_SEL2
R703 10K VCC3V3_HUB HUB2_CFG_SEL1
R704 10K HUB2_CFG_SEL0 GND
R705 10K HUB2_SDA GND
C703 1uF HUB2_VDD18 GND
C704 1uF HUB2_VDD18PLL GND
CAPS C705-C711 100nF VCC3V3_HUB GND
C712 4.7uF VCC3V3_HUB GND
# --- keyboard link: straight from the SoC (USB2 HOST3), not through a hub ---
P U1 Y2=USB2_HOST3_DP Y1=USB2_HOST3_DM
J20 JST_SH4 1=VBUS_KB 2=USB2_HOST3_DM 3=USB2_HOST3_DP 4=GND
F1 PTC:500mA VOUT_5V VBUS_KB
C713 10uF VBUS_KB GND
U51 USBLC6-2SC6 1=USB2_HOST3_DP 6=USB2_HOST3_DP 3=USB2_HOST3_DM 4=USB2_HOST3_DM 2=GND 5=VBUS_KB
# --- spare internal USB 2.0 port (USB2517 port 6), unpopulated header for a future internal device ---
J22 JST_SH4:DNP 1=VBUS_KB 2=USB_AUX_DM 3=USB_AUX_DP 4=GND

# ---- bay 5: USB 2.0 (USB2517 port 1) ----
J35 USBC16 A1=GND A12=GND B1=GND B12=GND SH=GND A4=VBUS_P5 A9=VBUS_P5 B4=VBUS_P5 B9=VBUS_P5
P J35 A5=CC1_P5 B5=CC2_P5 A6=USB_P5_DP B6=USB_P5_DP A7=USB_P5_DM B7=USB_P5_DM
NC J35 A8 B8
U752 USBLC6-2SC6 1=USB_P5_DP 6=USB_P5_DP 3=USB_P5_DM 4=USB_P5_DM 2=GND 5=VBUS_P5
R755 56K VBUS_P5 CC1_P5
R756 56K VBUS_P5 CC2_P5
U753 PWRSW:AP22804AW5 5=VOUT_5V 1=VBUS_P5 2=GND 4=HUB2_PRTPWR1 3=HUB2_OCS1_N
C755 100nF VOUT_5V GND
C756 47uF VBUS_P5 GND
C757 100nF VBUS_P5 GND
# ---- bay 6: USB 2.0 (USB2517 port 2) ----
J36 USBC16 A1=GND A12=GND B1=GND B12=GND SH=GND A4=VBUS_P6 A9=VBUS_P6 B4=VBUS_P6 B9=VBUS_P6
P J36 A5=CC1_P6 B5=CC2_P6 A6=USB_P6_DP B6=USB_P6_DP A7=USB_P6_DM B7=USB_P6_DM
NC J36 A8 B8
U762 USBLC6-2SC6 1=USB_P6_DP 6=USB_P6_DP 3=USB_P6_DM 4=USB_P6_DM 2=GND 5=VBUS_P6
R765 56K VBUS_P6 CC1_P6
R766 56K VBUS_P6 CC2_P6
U763 PWRSW:AP22804AW5 5=VOUT_5V 1=VBUS_P6 2=GND 4=HUB2_PRTPWR2 3=HUB2_OCS2_N
C765 100nF VOUT_5V GND
C766 47uF VBUS_P6 GND
C767 100nF VBUS_P6 GND
# ---- bay 7: USB 2.0 (USB2517 port 3) ----
J37 USBC16 A1=GND A12=GND B1=GND B12=GND SH=GND A4=VBUS_P7 A9=VBUS_P7 B4=VBUS_P7 B9=VBUS_P7
P J37 A5=CC1_P7 B5=CC2_P7 A6=USB_P7_DP B6=USB_P7_DP A7=USB_P7_DM B7=USB_P7_DM
NC J37 A8 B8
U772 USBLC6-2SC6 1=USB_P7_DP 6=USB_P7_DP 3=USB_P7_DM 4=USB_P7_DM 2=GND 5=VBUS_P7
R775 56K VBUS_P7 CC1_P7
R776 56K VBUS_P7 CC2_P7
U773 PWRSW:AP22804AW5 5=VOUT_5V 1=VBUS_P7 2=GND 4=HUB2_PRTPWR3 3=HUB2_OCS3_N
C775 100nF VOUT_5V GND
C776 47uF VBUS_P7 GND
C777 100nF VBUS_P7 GND
# ---- bay 8: USB 2.0 (USB2517 port 4) ----
J38 USBC16 A1=GND A12=GND B1=GND B12=GND SH=GND A4=VBUS_P8 A9=VBUS_P8 B4=VBUS_P8 B9=VBUS_P8
P J38 A5=CC1_P8 B5=CC2_P8 A6=USB_P8_DP B6=USB_P8_DP A7=USB_P8_DM B7=USB_P8_DM
NC J38 A8 B8
U782 USBLC6-2SC6 1=USB_P8_DP 6=USB_P8_DP 3=USB_P8_DM 4=USB_P8_DM 2=GND 5=VBUS_P8
R785 56K VBUS_P8 CC1_P8
R786 56K VBUS_P8 CC2_P8
U783 PWRSW:AP22804AW5 5=VOUT_5V 1=VBUS_P8 2=GND 4=HUB2_PRTPWR4 3=HUB2_OCS4_N
C785 100nF VOUT_5V GND
C786 47uF VBUS_P8 GND
C787 100nF VBUS_P8 GND
# ---- bay 9: USB 2.0 (USB2517 port 5) ----
J39 USBC16 A1=GND A12=GND B1=GND B12=GND SH=GND A4=VBUS_P9 A9=VBUS_P9 B4=VBUS_P9 B9=VBUS_P9
P J39 A5=CC1_P9 B5=CC2_P9 A6=USB_P9_DP B6=USB_P9_DP A7=USB_P9_DM B7=USB_P9_DM
NC J39 A8 B8
U792 USBLC6-2SC6 1=USB_P9_DP 6=USB_P9_DP 3=USB_P9_DM 4=USB_P9_DM 2=GND 5=VBUS_P9
R795 56K VBUS_P9 CC1_P9
R796 56K VBUS_P9 CC2_P9
U793 PWRSW:AP22804AW5 5=VOUT_5V 1=VBUS_P9 2=GND 4=HUB2_PRTPWR5 3=HUB2_OCS5_N
C795 100nF VOUT_5V GND
C796 47uF VBUS_P9 GND
C797 100nF VBUS_P9 GND
