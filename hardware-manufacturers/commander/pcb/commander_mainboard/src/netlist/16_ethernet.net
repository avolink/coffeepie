# Radxa ZERO 3E V1.2 sheet 16 (RGMII): RTL8211F-CG + discrete magnetics + RJ45.
# The four magnetics centre taps TR0..TR3_48V are the PoE pick-off. On the 3E they leave the board through
# mounting posts 1M1/1M4 to the PoE HAT; on the Commander they go straight to the on-board PD (30_poe.net).
SHEET ethernet
Y2 XTAL4:25MHz 1=PHY1_XTALOUT 2=GND 3=PHY1_XTALIN 4=GND
R31 22R PHY1_XTALOUT PHY1_XTALOUT1
C3 8.2pF PHY1_XTALOUT GND
C7 8.2pF PHY1_XTALIN GND
R34 DNP PHY1_XTALOUT PHY1_XTALIN
R72 100R GMAC1_MCLKINOUT_M1 PHY1_CLKOUT125
C96 DNP GMAC1_MCLKINOUT_M1 GND
R74 100R GMAC1_MCLKINOUT_M1 GND
U2 RTL8211F 1=MDI0_P 2=MDI0_N 3=VDD10_PHY1 4=MDI1_P 5=MDI1_N 6=MDI2_P 7=MDI2_N 8=VDD10_PHY1 9=MDI3_P 10=MDI3_N
P U2 11=VCC3V3_PHY1 12=GMAC1_RSTN 13=GMAC1_MDC_M1 14=GMAC1_MDIO_M1 15=GMAC1_TXD3_M1 16=GMAC1_TXD2_M1 17=GMAC1_TXD1_M1 18=GMAC1_TXD0_M1 19=GMAC1_TXEN_M1 20=GMAC1_TXCLK_M1
P U2 21=VDD10_PHY1 22=PHY1_RXD3_PHYAD0 23=PHY1_RXD2_PLLOFF 24=PHY1_RXD1_TXDLY 25=PHY1_RXD0_RXDLY 26=PHY1_RXDV_PHYAD2 27=PHY1_RXCLK_PHYAD1 28=VCCIO_PHY1 29=VCC3V3_PHY1 30=PHY1_REG_OUT
P U2 31=PHY1_INTB 32=PHY1_LED0_CFG_EXT 33=PHY1_LED1_CFG_LDO0 34=PHY1_LED2_CFG_LDO1 35=PHY1_CLKOUT125 36=PHY1_XTALIN 37=PHY1_XTALOUT1 38=VDD10_PHY1 39=PHY1_RSET 40=VCC3V3_PHY1 41=GND
R84 2.49K_1% PHY1_RSET GND
R88 0R PHY1_INTB GMAC1_INT_PMEB
R113 DNP VCC3V3_PHY1 GMAC1_RSTN
R115 1.5K GMAC1_MDIO_M1 VCCIO_PHY1
R116 22R PHY1_RXCLK_PHYAD1 GMAC1_RXCLK_M1
C121 DNP GMAC1_RXCLK_M1 GND
# strap resistors (PHY address 001, RGMII delays off, 3.3 V RGMII IO)
R76 DNP GND PHY1_LED0_CFG_EXT
R77 4.7K PHY1_LED0_CFG_EXT VCC3V3_PHY1
R78 4.7K GND PHY1_LED2_CFG_LDO1
R79 DNP PHY1_LED2_CFG_LDO1 VCC3V3_PHY1
R80 4.7K GND PHY1_LED1_CFG_LDO0
R87 4.7K PHY1_RXD3_PHYAD0 VCCIO_PHY1
R89 4.7K GND PHY1_RXCLK_PHYAD1
R90 DNP PHY1_RXCLK_PHYAD1 VCCIO_PHY1
R91 4.7K GND PHY1_RXDV_PHYAD2
R97 4.7K GND PHY1_RXD0_RXDLY
R98 DNP PHY1_RXD0_RXDLY VCCIO_PHY1
R99 4.7K GND PHY1_RXD1_TXDLY
R100 DNP PHY1_RXD1_TXDLY VCCIO_PHY1
R102 DNP GND PHY1_RXD2_PLLOFF
R103 4.7K PHY1_RXD2_PLLOFF VCCIO_PHY1
# PHY supplies
L7 2.2uH PHY1_REG_OUT VDD10_PHY1
C111 4.7uF VDD10_PHY1 GND
CAPS C112-C113 100nF VDD10_PHY1 GND
CAPS C108-C110 100nF VDD10_PHY1 GND
R101 DNP VCC_1V8 VCCIO_PHY1
R105 FB120R VCC_3V3 VCCIO_PHY1
C105 4.7uF VCCIO_PHY1 GND
C106 1uF VCCIO_PHY1 GND
C107 100nF VCCIO_PHY1 GND
R114 FB120R VCC_3V3 VCC3V3_PHY1
C114 4.7uF VCC3V3_PHY1 GND
CAPS C115-C116 100nF VCC3V3_PHY1 GND
C119 4.7uF VCC3V3_PHY1 GND
C120 100nF VCC3V3_PHY1 GND
# magnetics: PHY side CMC -> 1:1 transformer -> RJ45. Centre tap MCT = PoE pick-off, Bob-Smith 75R+1nF to chassis.
L22 CMC:CC2012A-801 1=MDI0_P 4=MDI0_TP 2=MDI0_N 3=MDI0_TN
L15 XFMR6:GB020G00 1=MDI0_TP 2=MDI0_TN 6=MDI0_TCT 5=PHY_MDI0_P 4=PHY_MDI0_N 3=TR0_48V
C98 100nF MDI0_TCT GND
R9 75R TR0_48V BS0
C60 1nF_2kV BS0 CHASSIS
L24 CMC:CC2012A-801 1=MDI1_P 4=MDI1_TP 2=MDI1_N 3=MDI1_TN
L23 XFMR6:GB020G00 1=MDI1_TP 2=MDI1_TN 6=MDI1_TCT 5=PHY_MDI1_P 4=PHY_MDI1_N 3=TR1_48V
C95 100nF MDI1_TCT GND
R17 75R TR1_48V BS1
C65 1nF_2kV BS1 CHASSIS
L26 CMC:CC2012A-801 1=MDI2_P 4=MDI2_TP 2=MDI2_N 3=MDI2_TN
L25 XFMR6:GB020G00 1=MDI2_TP 2=MDI2_TN 6=MDI2_TCT 5=PHY_MDI2_P 4=PHY_MDI2_N 3=TR2_48V
C97 100nF MDI2_TCT GND
R22 75R TR2_48V BS2
C16 1nF_2kV BS2 CHASSIS
L28 CMC:CC2012A-801 1=MDI3_P 4=MDI3_TP 2=MDI3_N 3=MDI3_TN
L27 XFMR6:GB020G00 1=MDI3_TP 2=MDI3_TN 6=MDI3_TCT 5=PHY_MDI3_P 4=PHY_MDI3_N 3=TR3_48V
C94 100nF MDI3_TCT GND
R23 75R TR3_48V BS3
C59 1nF_2kV BS3 CHASSIS
J12 RJ45_8P 1=PHY_MDI0_P 2=PHY_MDI0_N 3=PHY_MDI1_P 6=PHY_MDI1_N 4=PHY_MDI2_P 5=PHY_MDI2_N 7=PHY_MDI3_P 8=PHY_MDI3_N SH=CHASSIS
# Line-side TVS as on the 3E (D9..D23, BTR04G02). AUDIT: with PoE the line side floats up to 57 V above
# CHASSIS, so these need a stand-off of 58 V or more, or stay unpopulated. Fitted DNP on rev A.
D12 ESD:DNP PHY_MDI0_P CHASSIS
D9 ESD:DNP PHY_MDI0_N CHASSIS
D10 ESD:DNP PHY_MDI1_P CHASSIS
D11 ESD:DNP PHY_MDI1_N CHASSIS
D20 ESD:DNP PHY_MDI2_P CHASSIS
D21 ESD:DNP PHY_MDI2_N CHASSIS
D22 ESD:DNP PHY_MDI3_P CHASSIS
D23 ESD:DNP PHY_MDI3_N CHASSIS
