  (text "NEW (branch m2-hub): the bays, both hubs and the microSD slot moved to their own board (project commander_hub),\nwhich plugs into this mainboard through an M.2 Key M socket: card-edge fingers on the hub board, no plug part.\nThe pinout is in tools/hub_link.py (one source for both boards).  This sheet keeps what stays on the mainboard." (exclude_from_sim no) (at 15.24 25.4 0)
    (effects (font (size 1.524 1.524)) (justify left top)) (uuid "e93370bd-10d7-5d19-a872-b8eb36d9f3e8"))
  (symbol (lib_id "commander:M2_SOCKET_M") (at 57.15 48.26 0) (unit 1)
    (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no)
    (uuid "e53316b4-6b7e-5ce1-9783-f3d67cb01e8d")
    (property "Reference" "J41" (at 39.37 45.085 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Value" "M2_SOCKET_M" (at 49.53 45.085 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Footprint" "commander:M2_Socket_KeyM_LOTES_APCI0146" (at 57.15 48.26 0) (effects (font (size 1.27 1.27)) (hide yes)))
    (property "Datasheet" "" (at 57.15 48.26 0) (effects (font (size 1.27 1.27)) (hide yes)))
    (property "Description" "M.2 Key M socket H4.2, top mount, 4.05 mm, 67 contacts 0.5 mm, 0.5 A each, 25 cycles: LOTES APCI0107-P001A (LCSC C841661; land pattern identical to APCI0146). Carries the hub board link (tools/hub_link.py), not an M.2 slot" (at 57.15 48.26 0) (effects (font (size 1.27 1.27)) (hide yes)))
