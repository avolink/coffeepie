# The hub board's card edge: M.2 Key M fingers on a 0.8 mm board, into socket J41 of the mainboard.
# Pinout: tools/hub_link.py (one source for both boards).  Same net names on both sides.
SHEET hub_link
J90 M2_EDGE_M 1=GND 2=VCC5V_BUS 3=GND 4=VCC5V_BUS 5=HUB3_UP_RXN 6=VCC5V_BUS 7=HUB3_UP_RXP 8=VCC5V_BUS 9=GND 10=VCC5V_BUS 11=USB3_HOST1_SSRXN 12=VCC5V_BUS
P J90 13=USB3_HOST1_SSRXP 14=VCC5V_BUS 15=GND 16=VCC5V_BUS 17=USB3_HOST1_DM 18=VCC5V_BUS 19=USB3_HOST1_DP 20=VCC5V_BUS 21=GND 22=VCC5V_BUS 23=USB2_HOST2_DM 24=VCC5V_BUS
P J90 25=USB2_HOST2_DP 26=GND 27=GND 28=GND 29=USB_AUX_DM 30=GND 31=USB_AUX_DP 32=GND 33=GND 34=GND 35=SDMMC0_CLK 36=GND
P J90 37=GND 38=VCC_SYS 39=SDMMC0_CMD 40=VCC_SYS 41=SDMMC0_D0 42=GND 43=SDMMC0_D1 44=VCC3V3_SYS 45=GND 46=VCC3V3_SYS 47=SDMMC0_D2 48=GND
P J90 49=SDMMC0_D3 50=GND 51=GND 52=GND 53=SDMMC0_DET_L 54=GND 55=HUB_RESET_SOC_N 56=GND 57=GND 58=GND 67=I2C3_SCL_M1 68=GND
P J90 69=I2C3_SDA_M1 70=GND 71=GND 72=GND 73=GND 74=GND 75=GND
