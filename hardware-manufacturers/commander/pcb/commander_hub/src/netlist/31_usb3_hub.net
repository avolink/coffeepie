# NEW for the Commander: USB 3.2 Gen 1 hub (Microchip USB5744) on the RK3566 USB3 HOST1 port.
# Replaces the single Type-C USB3 port of the Radxa ZERO 3E (CH482D mux + ET7301B, sheet 14).
# Runs from its internal ROM defaults: no SPI flash, no SMBus pull-ups, all ports removable, no battery charging.
SHEET usb3_hub
U40 USB5744 45=USB3_HOST1_DP 46=USB3_HOST1_DM 47=HUB3_UP_TXP 48=HUB3_UP_TXN 50=HUB3_UP_RXP 51=HUB3_UP_RXN
P U40 1=USB_P1_DP 2=USB_P1_DM 3=HUB3_TXP1 4=HUB3_TXN1 6=HUB3_RXP1 7=HUB3_RXN1
P U40 8=USB_P2_DP 9=USB_P2_DM 10=HUB3_TXP2 11=HUB3_TXN2 13=HUB3_RXP2 14=HUB3_RXN2
P U40 17=USB_P3_DP 18=USB_P3_DM 19=HUB3_TXP3 20=HUB3_TXN3 22=HUB3_RXP3 23=HUB3_RXN3
P U40 24=USB_P4_DP 25=USB_P4_DM 26=HUB3_TXP4 27=HUB3_TXN4 29=HUB3_RXP4 30=HUB3_RXN4
P U40 36=HUB3_PRT_CTL1 35=HUB3_PRT_CTL2 34=HUB3_PRT_CTL3 32=HUB3_PRT_CTL4
P U40 37=HUB3_VBUS_DET 38=HUB3_SMCLK 39=HUB3_SMDAT 40=HUB3_CFG_BC_EN 41=HUB3_CFG_NON_REM 42=HUB_RESET_N
P U40 53=HUB3_XO 54=HUB3_XI 56=HUB3_RBIAS 57=GND
NC U40 52
N U40 VCC3V3_HUB 16 31 44 55
N U40 VCC1V2_HUB 5 12 15 21 28 33 43 49
# upstream: AC coupling at each transmitter (SoC TX -> hub RX, hub TX -> SoC RX)
C603 100nF HUB3_UP_TXP USB3_HOST1_SSRXP
C604 100nF HUB3_UP_TXN USB3_HOST1_SSRXN
# clock, bias, straps
Y40 XTAL4:25MHz 1=HUB3_XI 2=GND 3=HUB3_XO 4=GND
C605 12pF HUB3_XI GND
C606 12pF HUB3_XO GND
R601 12K_1% HUB3_RBIAS GND
R602 200K HUB3_CFG_NON_REM GND
R603 200K HUB3_CFG_BC_EN GND
R604 49.9K_1% VCC_SYS HUB3_VBUS_DET
R605 100K_1% HUB3_VBUS_DET GND
# optional SMBus access from the SoC (I2C3_M1). Leave unpopulated: 10k pull-ups on these two pins at
# reset would park the hub in SMBus-configuration mode waiting for a host command.
R606 DNP I2C3_SCL_M1 HUB3_SMCLK
R607 DNP I2C3_SDA_M1 HUB3_SMDAT
# reset: local RC so the hubs come up without software; the SoC can still pulse it low
R608 4.7K VCC3V3_HUB HUB_RESET_N
C607 1uF HUB_RESET_N GND
R609 0R HUB_RESET_SOC_N HUB_RESET_N
# decoupling
CAPS C608-C611 100nF VCC3V3_HUB GND
C612 4.7uF VCC3V3_HUB GND
CAPS C613-C620 100nF VCC1V2_HUB GND
C621 10uF VCC1V2_HUB GND
# --- hub supplies from the 5 V rail (keeps the hubs off the PMIC's 3.3 V buck) ---
# inductors: 2.2 uH in 2520 size, 1.2 mm tall, saturation current 2.3 A or more (each hub rail draws well under 1 A)
U41 BUCK_SOT235:TLV62569 4=VCC_SYS 1=VCC_SYS 2=GND 3=HUB_SW33 5=HUB_FB33
L41 2.2uH_2520 HUB_SW33 VCC3V3_HUB
R610 453K_1% VCC3V3_HUB HUB_FB33
R611 100K_1% HUB_FB33 GND
C622 10uF VCC_SYS GND
C623 22uF VCC3V3_HUB GND
U42 BUCK_SOT235:TLV62569 4=VCC_SYS 1=VCC_SYS 2=GND 3=HUB_SW12 5=HUB_FB12
L42 2.2uH_2520 HUB_SW12 VCC1V2_HUB
R612 100K_1% VCC1V2_HUB HUB_FB12
R613 100K_1% HUB_FB12 GND
C624 10uF VCC_SYS GND
C625 22uF VCC1V2_HUB GND

# ---- bay 1: USB 3.2 Gen 1 (USB5744 port 1) ----
J31 USBC24_SINK A1=GND A12=GND B1=GND B12=GND SH=GND A4=VBUS_P1 A9=VBUS_P1 B4=VBUS_P1 B9=VBUS_P1
P J31 A5=CC1_P1 B5=CC2_P1 A6=USB_P1_DP B6=USB_P1_DP A7=USB_P1_DM B7=USB_P1_DM
P J31 A2=SSTX1P_P1 A3=SSTX1N_P1 B11=SSRX1P_P1 B10=SSRX1N_P1 B2=SSTX2P_P1 B3=SSTX2N_P1 A11=SSRX2P_P1 A10=SSRX2N_P1
NC J31 A8 B8
# Type-C port controller with SuperSpeed 2:1 mux (TI HD3SS3220), wired as in Microchip's USB5744 figure
# "Downstream Port Type-C USB Connections": the controller reads the CC pins, advertises a source
# (PORT high = DFP, default USB current) and switches the hub's single SuperSpeed lane to whichever
# side of the receptacle the plug uses. GPIO mode (ADDR open): no I2C, no software.
U1011 HD3SS3220 2=CC1_P1 1=CC2_P1 6=HUB3_TXCP1 7=HUB3_TXCN1 9=HUB3_RXP1 10=HUB3_RXN1
P U1011 17=SSTX1P_P1 16=SSTX1N_P1 15=SSRX1CP_P1 14=SSRX1CN_P1 21=SSTX2P_P1 20=SSTX2N_P1 19=SSRX2CP_P1 18=SSRX2CN_P1
P U1011 30=VCC5V_BUS 8=VCC3V3_HUB 13=GND 28=GND 31=GND 29=GND 4=TYPEC_PORT_P1 5=TYPEC_VBUSDET_P1 11=TYPEC_DIR_P1
# ID goes low when a device is attached; it also enables the mux (ENn_MUX), so an empty bay is switched off
P U1011 27=TYPEC_ID_N_P1 12=TYPEC_ID_N_P1
NC U1011 3 22 23 24 25 26
R1011 909K_1% VBUS_P1 TYPEC_VBUSDET_P1
R1012 10K VCC5V_BUS TYPEC_PORT_P1
R1013 200K VCC3V3_HUB TYPEC_DIR_P1
R1014 200K VCC3V3_HUB TYPEC_ID_N_P1
C1013 100nF VCC5V_BUS GND
C1014 10uF VCC5V_BUS GND
C1015 100nF VCC3V3_HUB GND
# AC coupling: 100 nF on the transmit pair (hub side of the mux), 330 nF on each receive pair at the connector
C641 100nF HUB3_TXP1 HUB3_TXCP1
C642 100nF HUB3_TXN1 HUB3_TXCN1
C643 330nF SSRX1P_P1 SSRX1CP_P1
C644 330nF SSRX1N_P1 SSRX1CN_P1
C1011 330nF SSRX2P_P1 SSRX2CP_P1
C1012 330nF SSRX2N_P1 SSRX2CN_P1
# ESD on the connector side, one part per lane
U641 TPD4E05U06 1=SSTX1P_P1 10=SSTX1P_P1 2=SSTX1N_P1 9=SSTX1N_P1 4=SSRX1P_P1 7=SSRX1P_P1 5=SSRX1N_P1 6=SSRX1N_P1 3=GND 8=GND
U1012 TPD4E05U06 1=SSTX2P_P1 10=SSTX2P_P1 2=SSTX2N_P1 9=SSTX2N_P1 4=SSRX2P_P1 7=SSRX2P_P1 5=SSRX2N_P1 6=SSRX2N_P1 3=GND 8=GND
U642 USBLC6-2SC6 1=USB_P1_DP 6=USB_P1_DP 3=USB_P1_DM 4=USB_P1_DM 2=GND 5=VBUS_P1
# port power: PRT_CTLx is both the enable output and the over-current input on the USB5744.
# The controller's ID output does not gate VBUS: the bay is powered whenever the hub enables the port.
U643 PWRSW:AP22804AW5 5=VCC5V_BUS 1=VBUS_P1 2=GND 4=HUB3_PRT_CTL1 3=HUB3_PRT_CTL1
C645 100nF VCC5V_BUS GND
C646 47uF VBUS_P1 GND
C647 100nF VBUS_P1 GND
# ---- bay 2: USB 3.2 Gen 1 (USB5744 port 2) ----
J32 USBC24_SINK A1=GND A12=GND B1=GND B12=GND SH=GND A4=VBUS_P2 A9=VBUS_P2 B4=VBUS_P2 B9=VBUS_P2
P J32 A5=CC1_P2 B5=CC2_P2 A6=USB_P2_DP B6=USB_P2_DP A7=USB_P2_DM B7=USB_P2_DM
P J32 A2=SSTX1P_P2 A3=SSTX1N_P2 B11=SSRX1P_P2 B10=SSRX1N_P2 B2=SSTX2P_P2 B3=SSTX2N_P2 A11=SSRX2P_P2 A10=SSRX2N_P2
NC J32 A8 B8
# Type-C port controller with SuperSpeed 2:1 mux (TI HD3SS3220), wired as in Microchip's USB5744 figure
# "Downstream Port Type-C USB Connections": the controller reads the CC pins, advertises a source
# (PORT high = DFP, default USB current) and switches the hub's single SuperSpeed lane to whichever
# side of the receptacle the plug uses. GPIO mode (ADDR open): no I2C, no software.
U1021 HD3SS3220 2=CC1_P2 1=CC2_P2 6=HUB3_TXCP2 7=HUB3_TXCN2 9=HUB3_RXP2 10=HUB3_RXN2
P U1021 17=SSTX1P_P2 16=SSTX1N_P2 15=SSRX1CP_P2 14=SSRX1CN_P2 21=SSTX2P_P2 20=SSTX2N_P2 19=SSRX2CP_P2 18=SSRX2CN_P2
P U1021 30=VCC5V_BUS 8=VCC3V3_HUB 13=GND 28=GND 31=GND 29=GND 4=TYPEC_PORT_P2 5=TYPEC_VBUSDET_P2 11=TYPEC_DIR_P2
# ID goes low when a device is attached; it also enables the mux (ENn_MUX), so an empty bay is switched off
P U1021 27=TYPEC_ID_N_P2 12=TYPEC_ID_N_P2
NC U1021 3 22 23 24 25 26
R1021 909K_1% VBUS_P2 TYPEC_VBUSDET_P2
R1022 10K VCC5V_BUS TYPEC_PORT_P2
R1023 200K VCC3V3_HUB TYPEC_DIR_P2
R1024 200K VCC3V3_HUB TYPEC_ID_N_P2
C1023 100nF VCC5V_BUS GND
C1024 10uF VCC5V_BUS GND
C1025 100nF VCC3V3_HUB GND
# AC coupling: 100 nF on the transmit pair (hub side of the mux), 330 nF on each receive pair at the connector
C651 100nF HUB3_TXP2 HUB3_TXCP2
C652 100nF HUB3_TXN2 HUB3_TXCN2
C653 330nF SSRX1P_P2 SSRX1CP_P2
C654 330nF SSRX1N_P2 SSRX1CN_P2
C1021 330nF SSRX2P_P2 SSRX2CP_P2
C1022 330nF SSRX2N_P2 SSRX2CN_P2
# ESD on the connector side, one part per lane
U651 TPD4E05U06 1=SSTX1P_P2 10=SSTX1P_P2 2=SSTX1N_P2 9=SSTX1N_P2 4=SSRX1P_P2 7=SSRX1P_P2 5=SSRX1N_P2 6=SSRX1N_P2 3=GND 8=GND
U1022 TPD4E05U06 1=SSTX2P_P2 10=SSTX2P_P2 2=SSTX2N_P2 9=SSTX2N_P2 4=SSRX2P_P2 7=SSRX2P_P2 5=SSRX2N_P2 6=SSRX2N_P2 3=GND 8=GND
U652 USBLC6-2SC6 1=USB_P2_DP 6=USB_P2_DP 3=USB_P2_DM 4=USB_P2_DM 2=GND 5=VBUS_P2
# port power: PRT_CTLx is both the enable output and the over-current input on the USB5744.
# The controller's ID output does not gate VBUS: the bay is powered whenever the hub enables the port.
U653 PWRSW:AP22804AW5 5=VCC5V_BUS 1=VBUS_P2 2=GND 4=HUB3_PRT_CTL2 3=HUB3_PRT_CTL2
C655 100nF VCC5V_BUS GND
C656 47uF VBUS_P2 GND
C657 100nF VBUS_P2 GND
# ---- bay 3: USB 3.2 Gen 1 (USB5744 port 3) ----
J33 USBC24_SINK A1=GND A12=GND B1=GND B12=GND SH=GND A4=VBUS_P3 A9=VBUS_P3 B4=VBUS_P3 B9=VBUS_P3
P J33 A5=CC1_P3 B5=CC2_P3 A6=USB_P3_DP B6=USB_P3_DP A7=USB_P3_DM B7=USB_P3_DM
P J33 A2=SSTX1P_P3 A3=SSTX1N_P3 B11=SSRX1P_P3 B10=SSRX1N_P3 B2=SSTX2P_P3 B3=SSTX2N_P3 A11=SSRX2P_P3 A10=SSRX2N_P3
NC J33 A8 B8
# Type-C port controller with SuperSpeed 2:1 mux (TI HD3SS3220), wired as in Microchip's USB5744 figure
# "Downstream Port Type-C USB Connections": the controller reads the CC pins, advertises a source
# (PORT high = DFP, default USB current) and switches the hub's single SuperSpeed lane to whichever
# side of the receptacle the plug uses. GPIO mode (ADDR open): no I2C, no software.
U1031 HD3SS3220 2=CC1_P3 1=CC2_P3 6=HUB3_TXCP3 7=HUB3_TXCN3 9=HUB3_RXP3 10=HUB3_RXN3
P U1031 17=SSTX1P_P3 16=SSTX1N_P3 15=SSRX1CP_P3 14=SSRX1CN_P3 21=SSTX2P_P3 20=SSTX2N_P3 19=SSRX2CP_P3 18=SSRX2CN_P3
P U1031 30=VCC5V_BUS 8=VCC3V3_HUB 13=GND 28=GND 31=GND 29=GND 4=TYPEC_PORT_P3 5=TYPEC_VBUSDET_P3 11=TYPEC_DIR_P3
# ID goes low when a device is attached; it also enables the mux (ENn_MUX), so an empty bay is switched off
P U1031 27=TYPEC_ID_N_P3 12=TYPEC_ID_N_P3
NC U1031 3 22 23 24 25 26
R1031 909K_1% VBUS_P3 TYPEC_VBUSDET_P3
R1032 10K VCC5V_BUS TYPEC_PORT_P3
R1033 200K VCC3V3_HUB TYPEC_DIR_P3
R1034 200K VCC3V3_HUB TYPEC_ID_N_P3
C1033 100nF VCC5V_BUS GND
C1034 10uF VCC5V_BUS GND
C1035 100nF VCC3V3_HUB GND
# AC coupling: 100 nF on the transmit pair (hub side of the mux), 330 nF on each receive pair at the connector
C661 100nF HUB3_TXP3 HUB3_TXCP3
C662 100nF HUB3_TXN3 HUB3_TXCN3
C663 330nF SSRX1P_P3 SSRX1CP_P3
C664 330nF SSRX1N_P3 SSRX1CN_P3
C1031 330nF SSRX2P_P3 SSRX2CP_P3
C1032 330nF SSRX2N_P3 SSRX2CN_P3
# ESD on the connector side, one part per lane
U661 TPD4E05U06 1=SSTX1P_P3 10=SSTX1P_P3 2=SSTX1N_P3 9=SSTX1N_P3 4=SSRX1P_P3 7=SSRX1P_P3 5=SSRX1N_P3 6=SSRX1N_P3 3=GND 8=GND
U1032 TPD4E05U06 1=SSTX2P_P3 10=SSTX2P_P3 2=SSTX2N_P3 9=SSTX2N_P3 4=SSRX2P_P3 7=SSRX2P_P3 5=SSRX2N_P3 6=SSRX2N_P3 3=GND 8=GND
U662 USBLC6-2SC6 1=USB_P3_DP 6=USB_P3_DP 3=USB_P3_DM 4=USB_P3_DM 2=GND 5=VBUS_P3
# port power: PRT_CTLx is both the enable output and the over-current input on the USB5744.
# The controller's ID output does not gate VBUS: the bay is powered whenever the hub enables the port.
U663 PWRSW:AP22804AW5 5=VCC5V_BUS 1=VBUS_P3 2=GND 4=HUB3_PRT_CTL3 3=HUB3_PRT_CTL3
C665 100nF VCC5V_BUS GND
C666 47uF VBUS_P3 GND
C667 100nF VBUS_P3 GND
# ---- bay 4: USB 3.2 Gen 1 (USB5744 port 4) ----
J34 USBC24_SINK A1=GND A12=GND B1=GND B12=GND SH=GND A4=VBUS_P4 A9=VBUS_P4 B4=VBUS_P4 B9=VBUS_P4
P J34 A5=CC1_P4 B5=CC2_P4 A6=USB_P4_DP B6=USB_P4_DP A7=USB_P4_DM B7=USB_P4_DM
P J34 A2=SSTX1P_P4 A3=SSTX1N_P4 B11=SSRX1P_P4 B10=SSRX1N_P4 B2=SSTX2P_P4 B3=SSTX2N_P4 A11=SSRX2P_P4 A10=SSRX2N_P4
NC J34 A8 B8
# Type-C port controller with SuperSpeed 2:1 mux (TI HD3SS3220), wired as in Microchip's USB5744 figure
# "Downstream Port Type-C USB Connections": the controller reads the CC pins, advertises a source
# (PORT high = DFP, default USB current) and switches the hub's single SuperSpeed lane to whichever
# side of the receptacle the plug uses. GPIO mode (ADDR open): no I2C, no software.
U1041 HD3SS3220 2=CC1_P4 1=CC2_P4 6=HUB3_TXCP4 7=HUB3_TXCN4 9=HUB3_RXP4 10=HUB3_RXN4
P U1041 17=SSTX1P_P4 16=SSTX1N_P4 15=SSRX1CP_P4 14=SSRX1CN_P4 21=SSTX2P_P4 20=SSTX2N_P4 19=SSRX2CP_P4 18=SSRX2CN_P4
P U1041 30=VCC5V_BUS 8=VCC3V3_HUB 13=GND 28=GND 31=GND 29=GND 4=TYPEC_PORT_P4 5=TYPEC_VBUSDET_P4 11=TYPEC_DIR_P4
# ID goes low when a device is attached; it also enables the mux (ENn_MUX), so an empty bay is switched off
P U1041 27=TYPEC_ID_N_P4 12=TYPEC_ID_N_P4
NC U1041 3 22 23 24 25 26
R1041 909K_1% VBUS_P4 TYPEC_VBUSDET_P4
R1042 10K VCC5V_BUS TYPEC_PORT_P4
R1043 200K VCC3V3_HUB TYPEC_DIR_P4
R1044 200K VCC3V3_HUB TYPEC_ID_N_P4
C1043 100nF VCC5V_BUS GND
C1044 10uF VCC5V_BUS GND
C1045 100nF VCC3V3_HUB GND
# AC coupling: 100 nF on the transmit pair (hub side of the mux), 330 nF on each receive pair at the connector
C671 100nF HUB3_TXP4 HUB3_TXCP4
C672 100nF HUB3_TXN4 HUB3_TXCN4
C673 330nF SSRX1P_P4 SSRX1CP_P4
C674 330nF SSRX1N_P4 SSRX1CN_P4
C1041 330nF SSRX2P_P4 SSRX2CP_P4
C1042 330nF SSRX2N_P4 SSRX2CN_P4
# ESD on the connector side, one part per lane
U671 TPD4E05U06 1=SSTX1P_P4 10=SSTX1P_P4 2=SSTX1N_P4 9=SSTX1N_P4 4=SSRX1P_P4 7=SSRX1P_P4 5=SSRX1N_P4 6=SSRX1N_P4 3=GND 8=GND
U1042 TPD4E05U06 1=SSTX2P_P4 10=SSTX2P_P4 2=SSTX2N_P4 9=SSTX2N_P4 4=SSRX2P_P4 7=SSRX2P_P4 5=SSRX2N_P4 6=SSRX2N_P4 3=GND 8=GND
U672 USBLC6-2SC6 1=USB_P4_DP 6=USB_P4_DP 3=USB_P4_DM 4=USB_P4_DM 2=GND 5=VBUS_P4
# port power: PRT_CTLx is both the enable output and the over-current input on the USB5744.
# The controller's ID output does not gate VBUS: the bay is powered whenever the hub enables the port.
U673 PWRSW:AP22804AW5 5=VCC5V_BUS 1=VBUS_P4 2=GND 4=HUB3_PRT_CTL4 3=HUB3_PRT_CTL4
C675 100nF VCC5V_BUS GND
C676 47uF VBUS_P4 GND
C677 100nF VBUS_P4 GND
