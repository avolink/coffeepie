(version 1)
# J1, the mid-mount USB-C (HCTL HC-TYPE-C-16P-CB1.6): its pad row ends 0.17 mm from the end of its board notch, as in
# the maker's recommended layout (tools/usbc_mid_fp.py); everything else keeps the board's 0.20 mm.
(rule "J1 mid-mount pads to its notch"
  (condition "A.Parent == 'J1' && A.Type == 'Pad'")
  (constraint edge_clearance (min 0.15mm)))
