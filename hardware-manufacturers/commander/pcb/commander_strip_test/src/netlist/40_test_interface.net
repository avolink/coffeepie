# Commander STRIP TEST BOARD (rev T0) - everything that is NEW on the mainboard, without the codec core:
# PoE converter, PoE / battery selector, battery port, USB5744 + four SuperSpeed bays, USB2517 + five Hi-Speed bays.
# A stock Radxa ZERO 3E plays the codec core and connects with two USB-C cables and a few jumper wires.
# The shared sheets (poe, battery) are the mainboard's own netlist files, listed in shared.txt; the two hub
# sheets come from the same generator.  This sheet holds only what replaces the codec core.
SHEET testif

# --- upstream A: USB 3 from the ZERO 3E's Type-C host port, to the USB5744 ---
# Device-side receptacle: Rd on both CC pins. One SuperSpeed lane is wired (no orientation mux, as on the bays):
# if the hub enumerates at USB 2 speed only, turn the plug over.
J50 USBC24 A1=GND A12=GND B1=GND B12=GND SH=GND A4=VBUS_UPA A9=VBUS_UPA B4=VBUS_UPA B9=VBUS_UPA
P J50 A5=UPA_CC1 B5=UPA_CC2 A6=USB3_HOST1_DP B6=USB3_HOST1_DP A7=USB3_HOST1_DM B7=USB3_HOST1_DM
# the host transmits into our RX1 pair; our TX1 pair is the hub's upstream transmitter (AC-coupled by C603 / C604)
P J50 B11=USB3_HOST1_SSTXP B10=USB3_HOST1_SSTXN A2=USB3_HOST1_SSRXP A3=USB3_HOST1_SSRXN
NC J50 A8 B8 B2 B3 A10 A11
R911 5.1K UPA_CC1 GND
R912 5.1K UPA_CC2 GND
C911 100nF VBUS_UPA GND
TP11 TP VBUS_UPA

# --- upstream B: to the ZERO 3E's power / OTG Type-C port ---
# Feeds the ZERO 3E with 5 V from this board (so PoE or the battery runs the whole set-up) and carries USB 2 for the
# USB2517. The ZERO 3E must run that port in host mode (device tree: dr_mode = "host").
J51 USBC16 A1=GND A12=GND B1=GND B12=GND SH=GND A4=VBUS_UPB A9=VBUS_UPB B4=VBUS_UPB B9=VBUS_UPB
P J51 A5=UPB_CC1 B5=UPB_CC2 A6=USB2_HOST2_DP B6=USB2_HOST2_DP A7=USB2_HOST2_DM B7=USB2_HOST2_DM
NC J51 A8 B8
F2 PTC:2.5A VCC5V_BUS VBUS_UPB
R913 22K VBUS_UPB UPB_CC1
R914 22K VBUS_UPB UPB_CC2
C912 10uF VBUS_UPB GND

# --- PoE input: the four centre taps, wired from the ZERO 3E's PoE pick-off (PRIMARY side, up to 57 V) ---
J52 HDR1x4G:POE_TAPS 1=TR0_48V 2=TR1_48V 3=TR2_48V 4=TR3_48V

# --- control: jumper wires to the ZERO 3E 40-pin header ---
J53 HDR1x8G:CTRL 1=GND 2=VCC_3V3 3=I2C3_SDA_M1 4=I2C3_SCL_M1 5=TYPEC_INT 6=BATT_VBUS_EN 7=PWR_SRC_ST 8=BATT_VBUS_FLT_N
J54 HDR1x4G:AUX 1=GND 2=HUB_RESET_SOC_N 3=I2C2_SCL_M1 4=I2C2_SDA_M1

# --- rails the codec core provides on the mainboard ---
R915 FB120R_3A VCC5V_BUS VCC_SYS
C913 22uF VCC_SYS GND
C914 100nF VCC_SYS GND
# 3.3 V for the port controller and the pull-ups comes from the hub buck
R916 0R VCC3V3_HUB VCC_3V3
R917 2.2K VCC_3V3 I2C3_SCL_M1
R918 2.2K VCC_3V3 I2C3_SDA_M1
TP12 TP VCC_SYS
TP13 TP VCC_3V3
