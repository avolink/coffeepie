# Commander keyboard - the ATmega32U4 circuit of the Arduino Micro, reduced to what a bus-powered USB keyboard
# needs, so the microcontroller can be soldered straight onto the keyboard PCB instead of a plugged-in Micro.
#
# Kept from the Arduino Micro : the MCU and its pin assignment, 16 MHz crystal, 22 ohm USB series resistors,
#                               UCAP capacitor, HWB pull-down, reset pull-up + button, 500 mA fuse, ISP pins.
# Left out                    : 5 V and 3.3 V regulators and the VIN path (the keyboard is powered by USB only),
#                               the RX / TX / L / power LEDs, the pin headers.
# Changed                     : micro-USB -> USB-C (device side: 5.1 k on both CC pins), varistors -> one ESD array,
#                               ferrite + capacitor on AVCC.
# Net names are the ARDUINO pin names (D0..D13, A0..A5, MISO / SCK / MOSI), so the existing firmware and the
# existing key-matrix wiring carry over unchanged.  References are in a 100-block so they do not collide with
# the keyboard's own parts.
SHEET kbmcu

# --- microcontroller: ATmega32U4-AU (TQFP-44; the -MU is the same pin-out in QFN-44) ---
U101 ATMEGA32U4:ATmega32U4-AU 14=VCC5 34=VCC5 2=VCC5 7=VCC5 24=AVCC 44=AVCC 15=GND 23=GND 35=GND 43=GND 5=GND
P U101 6=UCAP 3=USB_MCU_DM 4=USB_MCU_DP 13=RESET_N 17=XTAL1 16=XTAL2 42=AREF 33=HWB
# port pins under their Arduino Micro names
P U101 20=D0_RX 21=D1_TX 19=D2_SDA 18=D3_SCL 25=D4 31=D5 27=D6 1=D7 28=D8 29=D9 30=D10 12=D11 26=D12 32=D13
P U101 36=A0 37=A1 38=A2 39=A3 40=A4 41=A5 11=MISO 9=SCK 10=MOSI 8=SS_RXLED 22=TXLED

# --- supply: USB bus power only ---
F101 PTC:500mA VBUS_USB VCC5
C101 1uF UCAP GND
C102 100nF VCC5 GND
C103 100nF VCC5 GND
C104 100nF VCC5 GND
C105 10uF VCC5 GND
FB101 600R_0603 VCC5 AVCC
C106 100nF AVCC GND
# optional: only needed if the firmware uses the external analogue reference
C107 100nF AREF GND

# --- clock: 16 MHz, as on the Arduino (the firmware and the bootloader assume it) ---
# 15 pF suits a 3225 crystal with 10 pF load capacitance; use the value that matches the crystal bought
Y101 XTAL4:16MHz 1=XTAL1 2=GND 3=XTAL2 4=GND
C108 15pF XTAL1 GND
C109 15pF XTAL2 GND
R105 1M XTAL1 XTAL2

# --- reset and boot ---
R106 10K VCC5 RESET_N
SW101 TACT:RESET 1=RESET_N 2=GND
R107 10K HWB GND

# --- USB-C, device side ---
J101 USBC16 A1=GND A12=GND B1=GND B12=GND SH=GND A4=VBUS_USB A9=VBUS_USB B4=VBUS_USB B9=VBUS_USB
P J101 A5=KB_CC1 B5=KB_CC2 A6=USB_CON_DP B6=USB_CON_DP A7=USB_CON_DM B7=USB_CON_DM
NC J101 A8 B8
R101 5.1K KB_CC1 GND
R102 5.1K KB_CC2 GND
R103 22R USB_CON_DP USB_MCU_DP
R104 22R USB_CON_DM USB_MCU_DM
U102 USBLC6-2SC6 1=USB_CON_DP 6=USB_CON_DP 3=USB_CON_DM 4=USB_CON_DM 2=GND 5=VBUS_USB
C110 4.7uF VBUS_USB GND

# --- in-system programming: needed once per board to load the Arduino bootloader ---
J102 ISP2x3 1=MISO 2=VCC5 3=SCK 4=MOSI 5=RESET_N 6=GND
