  (title_block (title "Commander numpad - Numpad module: 24 keys, each on its own pin (no matrix, no diodes)") (rev "A0") (company "Coffee Pie / Grupo 3P1 Colombia")
    (comment 1 "Codec Terminal, model Commander: RK3566 + PoE PD + USB hubs on one PCB")
